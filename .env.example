# ==========================================================================
# OmniView IQ — Environment Variables
# ==========================================================================
# Copy this file to .env and edit the values for your local setup.
#   cp .env.example .env
# ==========================================================================

# --- MQTT (Mosquitto) ---------------------------------------------------
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
# MQTT_CLIENT_ID=omniview-edge-myhost   # default: omniview-edge-{hostname}
MQTT_QOS=1                               # 0=fire-forget, 1=at-least-once (recommended)
MQTT_KEEPALIVE=60                        # seconds

# --- Site ----------------------------------------------------------------
# Site identifier used in MQTT topics: omniview/{SITE_ID}/{node}/{sensor}
SITE_ID=pune-isbm

# --- TimescaleDB ---------------------------------------------------------
TSDB_HOST=localhost
TSDB_PORT=5432
TSDB_DB=omniview
TSDB_USER=omniview
TSDB_PASSWORD=changeme

# --- Polling intervals (seconds) ----------------------------------------
POLL_ELECTRICAL_INTERVAL=15
POLL_PHYSICAL_INTERVAL=60

# --- Site config ---------------------------------------------------------
# Contracted / sanctioned maximum demand (kVA) with MSEDCL
# Default is the metaplan's modeled 500 kVA — confirm with site finance.
CONTRACTED_DEMAND_KVA=500
