{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Ambient Temp & Humidity Sensor Payload (Schneider PowerLogic TH110)",
  "type": "object",
  "properties": {
    "device_id": {
      "type": "string",
      "description": "Unique identifier for the sensor node"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "NTP-synced timestamp of when the reading was taken"
    },
    "sensor_type": {
      "type": "string",
      "const": "ambient_weather"
    },
    "data": {
      "type": "object",
      "properties": {
        "ambient_temp_c": { "type": "number", "description": "Ambient room temperature in Celsius" },
        "relative_humidity_pct": { "type": "number", "description": "Relative room humidity percentage" },
        "environmental_baseline_offset": { "type": "number", "description": "Edge-computed offset against machine cooling load demand" }
      },
      "required": [
        "ambient_temp_c",
        "relative_humidity_pct",
        "environmental_baseline_offset"
      ]
    }
  },
  "required": ["device_id", "timestamp", "sensor_type", "data"]
}
