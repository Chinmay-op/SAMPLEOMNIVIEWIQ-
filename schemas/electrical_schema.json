{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Electrical Sensor Payload (Selec MFM384)",
  "type": "object",
  "properties": {
    "device_id": {
      "type": "string",
      "description": "Unique identifier for the edge gateway or sensor node"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "NTP-synced timestamp of when the reading was taken"
    },
    "sensor_type": {
      "type": "string",
      "const": "electrical_meter"
    },
    "data": {
      "type": "object",
      "properties": {
        "voltage_v_ll_avg": { "type": "number", "description": "Average Line-to-Line Voltage" },
        "voltage_v_l1_n": { "type": "number", "description": "Phase R (L1) Line-to-Neutral Voltage" },
        "voltage_v_l2_n": { "type": "number", "description": "Phase Y (L2) Line-to-Neutral Voltage" },
        "voltage_v_l3_n": { "type": "number", "description": "Phase B (L3) Line-to-Neutral Voltage" },
        "current_a_avg": { "type": "number", "description": "Average Phase Current" },
        "current_a_l1": { "type": "number", "description": "Phase R (L1) Current in Amps" },
        "current_a_l2": { "type": "number", "description": "Phase Y (L2) Current in Amps" },
        "current_a_l3": { "type": "number", "description": "Phase B (L3) Current in Amps" },
        "current_a_neutral": { "type": "number", "description": "Neutral Current in Amps" },
        "active_power_kw_total": { "type": "number", "description": "Total Active Power in kW" },
        "active_power_kw_l1": { "type": "number", "description": "Phase R (L1) Active Power in kW" },
        "active_power_kw_l2": { "type": "number", "description": "Phase Y (L2) Active Power in kW" },
        "active_power_kw_l3": { "type": "number", "description": "Phase B (L3) Active Power in kW" },
        "apparent_power_kva_total": { "type": "number", "description": "Total Apparent Power in kVA" },
        "reactive_power_kvar_total": { "type": "number", "description": "Total Reactive Power in kVAR" },
        "power_factor_avg": { "type": "number", "description": "Average Power Factor" },
        "power_factor_l1": { "type": "number", "description": "Phase R (L1) Power Factor" },
        "power_factor_l2": { "type": "number", "description": "Phase Y (L2) Power Factor" },
        "power_factor_l3": { "type": "number", "description": "Phase B (L3) Power Factor" },
        "frequency_hz": { "type": "number", "description": "System Frequency in Hz" },
        "voltage_thd_percent": { "type": "number", "description": "Voltage Total Harmonic Distortion %" },
        "current_thd_percent": { "type": "number", "description": "Current Total Harmonic Distortion %" },
        "active_energy_kwh": { "type": "number", "description": "Total Active Energy (Import) in kWh" },
        "apparent_energy_kvah": { "type": "number", "description": "Total Apparent Energy in kVAh" },
        "delta_active_energy_kwh": { "type": "number", "description": "Active energy consumed in this polling interval (kWh)" },
        "delta_apparent_energy_kvah": { "type": "number", "description": "Apparent energy consumed in this polling interval (kVAh)" },
        "rolling_kva_15min": { "type": "number", "description": "15-minute rolling average of apparent power (edge-computed)" }
      },
      "required": [
        "voltage_v_ll_avg",
        "voltage_v_l1_n",
        "voltage_v_l2_n",
        "voltage_v_l3_n",
        "current_a_avg",
        "current_a_l1",
        "current_a_l2",
        "current_a_l3",
        "current_a_neutral",
        "active_power_kw_total",
        "active_power_kw_l1",
        "active_power_kw_l2",
        "active_power_kw_l3",
        "apparent_power_kva_total",
        "reactive_power_kvar_total",
        "power_factor_avg",
        "power_factor_l1",
        "power_factor_l2",
        "power_factor_l3",
        "frequency_hz",
        "voltage_thd_percent",
        "current_thd_percent",
        "active_energy_kwh",
        "apparent_energy_kvah",
        "delta_active_energy_kwh",
        "delta_apparent_energy_kvah",
        "rolling_kva_15min"
      ],
      "additionalProperties": false
    }
  },
  "required": ["device_id", "timestamp", "sensor_type", "data"],
  "additionalProperties": false
}
