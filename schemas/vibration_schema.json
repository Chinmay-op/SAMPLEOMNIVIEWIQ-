{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Vibration Sensor Payload (Banner QM30VT1)",
  "type": "object",
  "properties": {
    "device_id": {
      "type": "string",
      "description": "Unique identifier for the edge gateway or sensor node"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "NTP-synced timestamp of when the reading was taken"
    },
    "sensor_type": {
      "type": "string",
      "const": "vibration_node"
    },
    "data": {
      "type": "object",
      "properties": {
        "z_axis_rms_velocity_mm_sec": { "type": "number", "description": "Primary ISO 10816-3 RMS vibration velocity (Z-axis) in mm/s" },
        "x_axis_rms_velocity_mm_sec": { "type": "number", "description": "Lateral RMS vibration velocity (X-axis) in mm/s" },
        "z_axis_peak_acceleration_g": { "type": "number", "description": "High-frequency peak acceleration (Z-axis) in g" },
        "x_axis_peak_acceleration_g": { "type": "number", "description": "High-frequency peak acceleration (X-axis) in g" },
        "high_frequency_rms_acceleration_g": { "type": "number", "description": "High-frequency RMS acceleration in g for early bearing fault detection" },
        "z_axis_kurtosis": { "type": "number", "description": "Kurtosis of Z-axis vibration waveform (3.0 = Gaussian, >5.0 = impulsive fault)" },
        "x_axis_kurtosis": { "type": "number", "description": "Kurtosis of X-axis vibration waveform" },
        "z_axis_crest_factor": { "type": "number", "description": "Crest factor (peak/RMS) Z-axis" },
        "x_axis_crest_factor": { "type": "number", "description": "Crest factor (peak/RMS) X-axis" },
        "peak_velocity_component_freq_hz": { "type": "number", "description": "Frequency of the dominant velocity peak in Hz" },
        "temperature_c": { "type": "number", "description": "Surface temperature of the mounted component in Celsius" },
        "iso_health_zone": { "type": "string", "enum": ["ZONE_A", "ZONE_B", "ZONE_C", "ZONE_D"], "description": "Edge-computed ISO 10816-3 Health Zone classification" },
        "data_source": { "type": "string", "enum": ["synthetic", "CWRU"], "description": "Origin of the payload data" }
      },
      "required": [
        "z_axis_rms_velocity_mm_sec",
        "x_axis_rms_velocity_mm_sec",
        "z_axis_peak_acceleration_g",
        "x_axis_peak_acceleration_g",
        "high_frequency_rms_acceleration_g",
        "z_axis_kurtosis",
        "x_axis_kurtosis",
        "z_axis_crest_factor",
        "x_axis_crest_factor",
        "peak_velocity_component_freq_hz",
        "temperature_c",
        "iso_health_zone",
        "data_source"
      ]
    }
  },
  "required": ["device_id", "timestamp", "sensor_type", "data"]
}
